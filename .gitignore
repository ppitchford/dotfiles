# Exclude file for the ~/.dotfiles bare repo (work tree = $HOME).
#
# $HOME contains far more than dotfiles, so everything is ignored by default and
# tracked areas are re-included explicitly. Git will not look inside an ignored
# directory, so each level has to be un-ignored before the level below it can be
# — that is why .config and .local are listed on their own lines first.
#
# To start tracking a new area: add a `!` line for it here, then `dotfiles add`.

# Everything at the top level…
/*

# …except these.
!/.gitignore
!/.zprofile
!/.zshenv
!/.zshrc

# ── ~/.config ─────────────────────────────────────────────────────────────────
# Whitelisted per-directory: every installed app writes here, and blacklisting
# them one by one is a losing game. New files inside these dirs do show up.

!/.config
/.config/*
!/.config/fuzzel
!/.config/hypr
!/.config/kitty
!/.config/mako
!/.config/mango

# A file, not a directory: it carries the claude-cli and browser scheme
# handlers, and GTK "Open With" dialogs rewrite it in place. The obsidian
# handler went with the application on 2026-08-19.
!/.config/mimeapps.list
!/.config/user-dirs.dirs
!/.config/mise
!/.config/nvim

# ornatus's own config: it names the wallpaper path, so the black desktop is
# only reproducible on a rebuild if this is tracked. Config-only directory —
# the location cache lives under XDG_CACHE_HOME and the pid file under
# XDG_RUNTIME_DIR, so nothing stateful lands here.
!/.config/ornatus
!/.config/satty
!/.config/theme
!/.config/varia
!/.config/waybar
!/.config/xdg-desktop-portal
!/.config/yazi

# Runtime state, not configuration — written by the theme switcher.
/.config/theme/current

# The symlinks ornatus repoints at sunrise and sunset. Same category as the
# marker above: they record which theme is active, not how it is configured,
# and tracking them dirtied the tree twice a day. ornatus recreates them on
# its first apply, so a rebuild loses nothing.
/.config/fuzzel/fuzzel.ini
/.config/kitty/current-theme.conf
/.config/mako/config

# black.jpg — the desktop itself, a 64x64 solid black JPEG that ornatus scales
# to cover. Needs no rule of its own; the directory above already tracks it.
# It lives here rather than ~/Pictures because it is part of the theme, not a
# photograph, and this keeps it in an already-tracked area. Regenerate with:
#   ffmpeg -f lavfi -i color=c=black:s=64x64 -frames:v 1 -q:v 1 black.jpg

# ── ~/.local ──────────────────────────────────────────────────────────────────
# bin is visible wholesale so new scripts surface on their own; excluded by
# name are build outputs from projects with their own repos, and downloads.
# applications holds the .desktop entries that put `varia` modes in fuzzel.

!/.local
/.local/*
!/.local/bin
/.local/bin/ornatus
/.local/bin/frame
# IWE: built from github.com/iwe-org/iwe, ~65MB of binaries.
/.local/bin/iwe
/.local/bin/iwes
/.local/bin/iwec

# opt is left to the blanket rule above: it holds the browser tree that
# helium-update installs, far too large to track and reproducible from that
# script alone.

!/.local/share
/.local/share/*
# icons stays untracked on purpose: the launcher artwork ships inside the
# upstream tarball, and helium-update reinstalls it on every run, so tracking
# it would duplicate a generated file.
!/.local/share/applications
# Generated by update-desktop-database, and by GTK's Open With dialog.
/.local/share/applications/mimeinfo.cache
/.local/share/applications/userapp-*.desktop

# ── ~/.claude ─────────────────────────────────────────────────────────────────
# CLAUDE.md and skills are configuration; everything else is local state.

!/.claude
/.claude/*
!/.claude/CLAUDE.md
!/.claude/skills

# Local Claude state in any project directory.
**/.claude/settings.local.json

# ── ~/system ──────────────────────────────────────────────────────────────────
# Root-owned files mirrored for versioning; installed by system/install.sh.

!/system

# ── ~/bin ─────────────────────────────────────────────────────────────────────
# Scheduled scripts run from cron. The crontab itself lives in a root-owned
# spool and cannot be tracked, so the schedule is documented in each script.

!/bin
