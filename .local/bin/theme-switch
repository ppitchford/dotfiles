#!/usr/bin/bash

# ── Configuration ─────────────────────────────────────────────────────────────
# Central paths and timing constants. Adjust POLL_MARGIN to control how many
# seconds before/after a transition the daemon rechecks the theme.

THEME_DIR="$HOME/.config/theme"
THEME_FILE="$THEME_DIR/current"
CACHE_FILE="$HOME/.cache/theme-switch"
CONFIG_DIR="$HOME/.config"
LOCATION_TTL=86400  # Re-fetch location once per day (seconds)
POLL_MARGIN=60      # Re-poll this many seconds after a transition to confirm

# Ensure required directories exist
mkdir -p "$THEME_DIR" "$HOME/.cache"

# ── Theme application ─────────────────────────────────────────────────────────
# Creates symlinks from the consolidated theme directory to each app's expected
# config path, then signals each app to reload its configuration.
# Falls back gracefully if a theme file is missing.

apply_theme() {
    local theme="$1"

    # Write current theme name for Quickshell and other watchers
    echo "$theme" > "$THEME_FILE"

    # Map of source theme files to their app config symlink targets
    declare -A links=(
	["$THEME_DIR/$theme/swaylock.conf"]="$CONFIG_DIR/swaylock/current-theme.conf"
        ["$THEME_DIR/$theme/kitty.conf"]="$CONFIG_DIR/kitty/current-theme.conf"
        ["$THEME_DIR/$theme/fuzzel.ini"]="$CONFIG_DIR/fuzzel/fuzzel.ini"
        ["$THEME_DIR/$theme/mako.conf"]="$CONFIG_DIR/mako/config"
        ["$THEME_DIR/$theme/mango.conf"]="$CONFIG_DIR/mango/theme.conf"
    )

    for src in "${!links[@]}"; do
        local dst="${links[$src]}"
        if [[ -f "$src" ]]; then
            ln -sf "$src" "$dst"
        else
            echo "theme-switch: missing theme file: $src" >&2
        fi
    done

    # Set wallpaper to match theme
    if [[ "$theme" == "dark" ]]; then
        swww img ~/Pictures/wallpapers/junji-ito-dark.png \
            --transition-type fade --transition-duration 1
    else
        swww img ~/Pictures/wallpapers/junji-ito-light.png \
            --transition-type fade --transition-duration 1
    fi

    # Signal each app to reload — errors suppressed since apps may not be running
    pkill -SIGUSR1 kitty  2>/dev/null   # Kitty reloads config on SIGUSR1
    makoctl reload        2>/dev/null   # Mako notification daemon
    mmsg -d reload_config 2>/dev/null   # MangoWM compositor
    # Fuzzel reads config on each launch — no reload needed
    # Yazi detects terminal background change via Kitty — no reload needed
}

# ── Location (cached daily) ───────────────────────────────────────────────────
# Fetches coordinates from ipapi.co and caches them for 24 hours.
# Returns "lat lon" on stdout, exits non-zero on failure.

get_location() {
    local now
    now=$(date +%s)

    # Use cached coordinates if they're less than LOCATION_TTL seconds old
    if [[ -f "$CACHE_FILE" ]]; then
        local cached_time cached_lat cached_lon
        IFS=',' read -r cached_time cached_lat cached_lon < "$CACHE_FILE"
        if (( now - cached_time < LOCATION_TTL )); then
            echo "$cached_lat $cached_lon"
            return 0
        fi
    fi

    # Fetch fresh coordinates
    local location lat lon
    location=$(curl -sf --max-time 5 "https://ipapi.co/json/") || return 1
    lat=$(echo "$location" | jq -r '.latitude')
    lon=$(echo "$location" | jq -r '.longitude')
    [[ "$lat" == "null" || -z "$lat" ]] && return 1

    # Cache the result with a timestamp
    echo "$(date +%s),$lat,$lon" > "$CACHE_FILE"
    echo "$lat $lon"
}

# ── Sunrise/sunset lookup ─────────────────────────────────────────────────────
# Fetches today's sunrise and sunset as Unix timestamps.
# Returns "sunrise_ts sunset_ts" on stdout, exits non-zero on failure.

get_sun_times() {
    local lat="$1" lon="$2"
    local today sun sunrise sunset sunrise_ts sunset_ts

    today=$(date +%Y-%m-%d)
    sun=$(curl -sf --max-time 5 \
        "https://api.sunrise-sunset.org/json?lat=${lat}&lng=${lon}&formatted=0&date=${today}") \
        || return 1

    sunrise=$(echo "$sun" | jq -r '.results.sunrise')
    sunset=$(echo "$sun"  | jq -r '.results.sunset')

    sunrise_ts=$(date -d "$sunrise" +%s 2>/dev/null) || return 1
    sunset_ts=$(date  -d "$sunset"  +%s 2>/dev/null) || return 1

    echo "$sunrise_ts $sunset_ts"
}

# ── Theme determination ───────────────────────────────────────────────────────
# Determines whether it is currently day or night based on sunrise/sunset times.
# Returns "light" during the day, "dark" at night. Falls back to "dark" on any
# network or parsing error.

get_theme() {
    local lat lon sunrise_ts sunset_ts now

    read -r lat lon <<< "$(get_location)" || { echo "dark"; return; }
    read -r sunrise_ts sunset_ts <<< "$(get_sun_times "$lat" "$lon")" \
        || { echo "dark"; return; }

    now=$(date +%s)
    [[ "$now" -ge "$sunrise_ts" && "$now" -lt "$sunset_ts" ]] \
        && echo "light" || echo "dark"
}

# ── Sleep until next transition ───────────────────────────────────────────────
# Calculates how many seconds until the next sunrise or sunset and sleeps until
# then, plus a small margin to ensure the transition has occurred.
# Falls back to a 5-minute poll if sun times cannot be determined.

sleep_until_transition() {
    local lat lon sunrise_ts sunset_ts now next_event sleep_secs

    read -r lat lon <<< "$(get_location)" 2>/dev/null || { sleep 300; return; }
    read -r sunrise_ts sunset_ts <<< "$(get_sun_times "$lat" "$lon")" 2>/dev/null \
        || { sleep 300; return; }

    now=$(date +%s)

    if (( now < sunrise_ts )); then
        next_event=$sunrise_ts   # Before sunrise — sleep until sunrise
    elif (( now < sunset_ts )); then
        next_event=$sunset_ts    # After sunrise, before sunset — sleep until sunset
    else
        next_event=$(( sunrise_ts + 86400 ))  # After sunset — sleep until tomorrow's sunrise
    fi

    sleep_secs=$(( next_event - now + POLL_MARGIN ))
    (( sleep_secs < 60 )) && sleep_secs=60  # Never sleep less than 1 minute

    sleep "$sleep_secs"
}

# ── Signal handler ────────────────────────────────────────────────────────────
# Allows forcing an immediate theme refresh by sending SIGUSR1 to this process.
# Useful when changing timezones while travelling.
# Usage: pkill -SIGUSR1 theme-switch

force_refresh=0
trap 'force_refresh=1' SIGUSR1

# ── Main loop ─────────────────────────────────────────────────────────────────
# On startup, wait 5 seconds for the compositor and apps to initialize, then
# apply the correct theme immediately. Subsequently, sleep until the next
# sunrise/sunset transition rather than polling on a fixed interval.

current_theme=""
sleep 5

while true; do
    # Apply theme if it has changed or a manual refresh was requested
    if (( force_refresh )) || new_theme=$(get_theme) && [[ "$new_theme" != "$current_theme" ]]; then
        force_refresh=0
        new_theme=$(get_theme)
        apply_theme "$new_theme"
        current_theme="$new_theme"
    fi

    # Sleep precisely until the next transition
    sleep_until_transition
done
