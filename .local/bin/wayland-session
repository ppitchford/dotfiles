#!/bin/sh
pipewire &
pipewire-pulse &
wireplumber &
mako &
/usr/libexec/hyprpolkitagent &
hypridle &
wl-paste --watch cliphist store &

# waybar died mid-session on 2026-08-18 and left no trace: nothing restarted
# it and its output went nowhere. Supervise it, record every exit, and stop
# after ten immediate failures — that means a broken config, not a hotplug.
# The battery module chatters its charge state to stdout on each poll, so it
# is filtered out to keep the log readable.
waybar_supervise() {
	sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${WAYLAND_DISPLAY:-wayland-0}"
	fails=0
	while [ -S "$sock" ] && [ "$fails" -lt 10 ]; do
		started=$(date +%s)
		waybar
		rc=$?
		printf '=== %s waybar exited rc=%s\n' "$(date -Is)" "$rc"
		if [ $(($(date +%s) - started)) -lt 5 ]; then
			fails=$((fails + 1))
		else
			fails=0
		fi
		sleep 2
	done
	printf '=== %s waybar supervisor stopped (fails=%s)\n' "$(date -Is)" "$fails"
}
waybar_supervise 2>&1 |
	grep --line-buffered -vxE 'Charging|Discharging|Plugged|Not charging|Full|Unknown' \
		>>"${XDG_CACHE_HOME:-$HOME/.cache}/waybar.log" &

~/.local/bin/ornatus > /tmp/ornatus.log 2>&1 &

