#!/usr/bin/env python3
"""Render the notes as a link graph.

Nodes are documents, edges are wiki links. Notes with no link in either
direction are drawn dashed and grey — that is the review signal, not a
verdict: a new note may link to nothing yet.

Usage: note-graph [OUTPUT_PREFIX] [--notes DIR] [--all]

OUTPUT_PREFIX defaults to $XDG_CACHE_HOME/note-graph/notes, producing
<prefix>.dot, <prefix>.svg and <prefix>.png.
"""
import argparse, glob, os, re, shutil, subprocess, sys, textwrap

SYSTEM = {"CLAUDE.md", "README.md"}
WIKI = re.compile(r"\[\[([^\]|#]+)")


def cache_home():
    return os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")


def read_graph(notes, include_system):
    files = sorted(os.path.basename(p) for p in glob.glob(os.path.join(notes, "*.md")))
    if not files:
        sys.exit(f"note-graph: no markdown documents in {notes}")
    names = {os.path.splitext(f)[0] for f in files}
    kept = files if include_system else [f for f in files if f not in SYSTEM]
    keys = [os.path.splitext(f)[0] for f in kept]
    system_keys = {os.path.splitext(f)[0] for f in SYSTEM}

    edges, elsewhere = set(), {}
    for f in files:
        src = os.path.splitext(f)[0]
        targets = set(WIKI.findall(open(os.path.join(notes, f), encoding="utf-8").read()))
        for tgt in targets:
            tgt = tgt.strip()
            if tgt not in names or tgt == src:
                continue
            if src in keys and tgt in keys:
                edges.add((src, tgt))
            elif src in system_keys:
                elsewhere.setdefault(tgt, set()).add(src)
    return keys, edges, elsewhere


def write_dot(path, keys, edges):
    degree = dict.fromkeys(keys, 0)
    for a, b in edges:
        degree[a] += 1
        degree[b] += 1
    q = lambda s: s.replace('"', '\\"')
    label = lambda k: "\\n".join(textwrap.wrap(k, 22)).replace('"', '\\"')

    out = [
        "digraph notes {",
        '  layout=sfdp overlap=prism sep="+14" splines=curved bgcolor="#faf9f7"',
        '  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=11',
        '        fillcolor="#ffffff" color="#c9c4bd" penwidth=1.2 margin="0.14,0.09"]',
        '  edge [color="#9a938a" penwidth=1.0 arrowsize=0.6]',
    ]
    for k in keys:
        if degree[k]:
            out.append(f'  "{q(k)}" [label="{label(k)}" fontsize={11 + min(degree[k], 8)}]')
        else:
            out.append(
                f'  "{q(k)}" [label="{label(k)}" fillcolor="#f2efe9" color="#ccc5ba"'
                ' style="rounded,filled,dashed" fontcolor="#8a8378"]'
            )
    out += [f'  "{q(a)}" -> "{q(b)}"' for a, b in sorted(edges)]
    out.append("}")
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out) + "\n")
    return degree


def main():
    ap = argparse.ArgumentParser(add_help=True, description="Render the notes as a link graph.")
    ap.add_argument("prefix", nargs="?", help="output path prefix (default: $XDG_CACHE_HOME/note-graph/notes)")
    ap.add_argument("--notes", default=os.path.expanduser("~/notes"))
    ap.add_argument("--all", action="store_true", help="include Log, Conventions and CLAUDE.md as nodes")
    args = ap.parse_args()

    if not shutil.which("dot"):
        sys.exit("note-graph: graphviz is not installed (xbps-install graphviz)")
    notes = os.path.expanduser(args.notes)
    if not os.path.isdir(notes):
        sys.exit(f"note-graph: {notes} is not a directory")

    prefix = args.prefix or os.path.join(cache_home(), "note-graph", "notes")
    os.makedirs(os.path.dirname(os.path.abspath(prefix)), exist_ok=True)

    keys, edges, elsewhere = read_graph(notes, args.all)
    degree = write_dot(prefix + ".dot", keys, edges)
    for fmt in ("svg", "png"):
        cmd = ["dot", "-Ksfdp", f"-T{fmt}", prefix + ".dot", "-o", f"{prefix}.{fmt}"]
        if fmt == "png":
            cmd.insert(1, "-Gdpi=110")
        subprocess.run(cmd, check=True)

    unlinked = sorted(k for k in keys if not degree[k])
    print(f"{len(keys)} documents, {len(edges)} links, {len(unlinked)} unlinked")
    for k in unlinked:
        via = elsewhere.get(k)
        print(f"  {k}" + (f"  [reached only from {', '.join(sorted(via))}]" if via else ""))
    print(f"\nwrote {prefix}.dot, {prefix}.svg, {prefix}.png")


if __name__ == "__main__":
    main()
