#!/usr/bin/bash

# ── varia ─────────────────────────────────────────────────────────────────────
# The miscellany fuzzel cannot do on its own. Applications are launched by
# fuzzel natively; each mode here is reached from its own .desktop entry in
# ~/.local/share/applications/, so the fuzzel prompt is the only entry point.
#
#   calc       calculator via qalc, result copied to clipboard
#   files      file search under $HOME via fd, opened with xdg-open
#   emoji      emoji picker, character copied to clipboard
#   symbols    arrows, maths, typography and accents, likewise
#   clipboard  clipboard history via cliphist
#   system     suspend, lock, shutdown, reboot, logout
#
# Local only — nothing here touches the network.

set -u

# ── Menu ──────────────────────────────────────────────────────────────────────
# fuzzel reads geometry, font and colours from ~/.config/fuzzel/fuzzel.ini,
# which ornatus symlinks into the active theme bundle. Reads newline-separated
# items on stdin, prints the selection.

menu() {
    fuzzel --dmenu --prompt "$1"
}

# Prompt for a line of text with no candidate list.
prompt() {
    fuzzel --dmenu --lines 0 --prompt "$1" < /dev/null
}

# ── Modes ─────────────────────────────────────────────────────────────────────

mode_calc() {
    local expr
    expr=$(prompt "= ")
    [[ -z "$expr" ]] && return
    local result
    result=$(qalc -t "$expr" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | xargs)
    [[ -z "$result" ]] && return
    # The result is shown rather than copied silently, so a misparse is visible
    # before it reaches the clipboard. Return copies, Escape discards.
    [[ -z "$(printf '%s' "$result" | menu "= ")" ]] && return
    printf '%s' "$result" | wl-copy
}

mode_files() {
    # One window: the whole candidate list is fed up front, so typing narrows
    # and backspace widens. fd walks 264k paths in 70ms and fuzzel filters the
    # result without perceptible lag, so there is no reason to prompt first.
    #
    # The exclusions are a denylist rather than an allowlist: a new noisy
    # directory shows up as junk in the results and gets added here, whereas a
    # missing allowlist entry would fail silently. .local costs ~/.local/bin,
    # which is on $PATH anyway; nvim and mise account for 72k of its 74k.
    local selection
    selection=$(fd --hidden \
        --exclude .git --exclude node_modules --exclude target \
        --exclude .cache --exclude .cargo --exclude .npm \
        --exclude .local --exclude go \
        --exclude mozilla --exclude net.imput.helium \
        --exclude 1Password --exclude obsidian \
        . "$HOME" 2>/dev/null | menu "Open: ")
    [[ -z "$selection" ]] && return
    xdg-open "$selection" &>/dev/null &
}

# Shared by the emoji and symbols modes: same format, same behaviour, two
# files. $1 is the file under ~/.config/varia/, $2 the prompt.
mode_pick() {
    local list="$HOME/.config/varia/$1"
    [[ -r "$list" ]] || return
    local selection
    # Comments and blank lines are stripped; the whole line is matched against,
    # so the descriptions act as search terms.
    selection=$(grep -v '^#\|^$' "$list" | menu "$2")
    [[ -z "$selection" ]] && return
    # First field is the character, the rest is its description.
    printf '%s' "${selection%% *}" | wl-copy
}

mode_clipboard() {
    local selection
    selection=$(cliphist list | menu "Clipboard: ")
    [[ -z "$selection" ]] && return
    cliphist decode <<< "$selection" | wl-copy
}

mode_system() {
    local selection
    selection=$(printf "  Suspend\n  Lock\n  Shutdown\n  Reboot\n  Logout" \
        | menu "System: ")
    case "$selection" in
        *Suspend)  hyprlock & sleep 0.5; loginctl suspend ;;
        *Lock)     hyprlock ;;
        *Shutdown) loginctl poweroff ;;
        *Reboot)   loginctl reboot ;;
        *Logout)   pkill -x mango ;;
    esac
}

# ── Main ──────────────────────────────────────────────────────────────────────

case "${1-}" in
    calc)      mode_calc ;;
    files)     mode_files ;;
    emoji)     mode_pick emoji "Emoji: " ;;
    symbols)   mode_pick symbols "Symbol: " ;;
    clipboard) mode_clipboard ;;
    system)    mode_system ;;
    *)
        printf 'usage: %s {calc|files|emoji|symbols|clipboard|system}\n' "${0##*/}" >&2
        exit 2
        ;;
esac
